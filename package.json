{
  "name": "xtudynote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:textbook-ai": "node scripts/smoke-test-textbook-provider.mjs",
    "test:textbook-quality": "node --test scripts/test-academy-textbook-quality.mjs",
