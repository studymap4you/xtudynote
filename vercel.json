{
  "functions": {
    "api/woohyukmon-chat.mjs": {
      "maxDuration": 30
    },
    "api/generate-premium-textbook.mjs": {
      "maxDuration": 60
    },
    "api/generate-academy-textbook.mjs": {
      "maxDuration": 300
    },
    "api/csat-question-engine.mjs": {
      "maxDuration": 300
    },
    "api/admin-exam-collector.mjs": {
      "maxDuration": 30
    },
    "api/exam-library.mjs": {
      "maxDuration": 30
    },
    "api/billing.mjs": {
      "maxDuration": 120
    },
    "api/billing-cron.mjs": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/billing-cron",
      "schedule": "0 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
