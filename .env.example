# Copy to `.env.local` — values from Firebase Console → Project settings → Your apps (Web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions (학습지 이메일 배포 등). Firebase 콘솔에 배포한 Functions 리전과 동일하게.
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3
# 로컬 에뮬레이터: VITE_FIREBASE_FUNCTIONS_EMULATOR=true

# ——— 외부 이메일 배포 테스트용 (선생님 메일 SMTP) ———
# 실제 발송은 Cloud Functions 파라미터(콘솔)에도 동일 값을 넣어야 합니다. 로컬에서만 복사해 쓰려면 .env.local에 넣으세요.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=앱비밀번호
# MAIL_FROM=your.email@gmail.com
# APP_PUBLIC_ORIGIN=http://localhost:3000

# EmailJS — 템플릿 수신(To): {{email}}, 본문: homework_code, message, to_name
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Google Drive Picker — OAuth Web client + Browser API key (HTTP referrer: http://localhost:3000/*)
# `npm run dev`는 vite.config 기준 포트 3000 (OAuth 승인된 원본과 동일하게 맞춤)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# OpenAI — Signal Logic 분석 (JSON 모드). 공개 배포 시에는 반드시 서버 경유로 전환하세요.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# 교재 자동제작 서버 AI. 기본값은 NVIDIA이며 OpenAI 유료 호출은 명시적으로 허용하기 전까지 차단됩니다.
TEXTBOOK_AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# CSAT 문제 생성은 아래 세 모델을 순서대로 호출합니다. 모델별 키는 선택 사항이며 공통 키보다 우선합니다.
NVIDIA_MODELS_QUESTIONS=nvidia/nemotron-3.5-lightning-30b-a3b,meta/muse-glimmer-30b,google/diffusiongemma-26b-a4b-it
# NVIDIA_API_KEY_NEMOTRON=
# NVIDIA_API_KEY_MUSE_GLIMMER=
# NVIDIA_API_KEY_DIFFUSIONGEMMA=
NVIDIA_ENABLE_THINKING=true
TEXTBOOK_ALLOW_PAID_OPENAI=false
# OPENAI_API_KEY=
# OPENAI_MODEL_ACADEMY=gpt-4o-mini

# Xtudy Standard 구독 결제 — 실제 Secret은 Vercel server-only 환경변수에만 등록합니다.
FIREBASE_SERVICE_ACCOUNT_JSON=
APP_PUBLIC_ORIGIN=
# 대규모 검수 문제은행은 Firebase Storage 샤드로 조회하고 Firestore 색인을 함께 사용합니다.
PROBLEM_BANK_PROJECT_ID=xstudy-problem-bank
PROBLEM_BANK_STORAGE_BUCKET=xtudynote.firebasestorage.app
PROBLEM_BANK_STORAGE_SHARDS_ENABLED=true
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TCSUBSCRIP
KAKAOPAY_CID_SECRET=
BILLING_LIVE_ENABLED=false
# 무통장 입금 임시 운영. 계좌는 공개 결제 안내 정보이며 Secret이 아닙니다.
BANK_TRANSFER_BANK_NAME=지역농협
BANK_TRANSFER_ACCOUNT_NUMBER=3521660492353
BANK_TRANSFER_ACCOUNT_HOLDER=
# Toss·KakaoPay 계약/키 등록 후에만 true로 전환합니다.
BILLING_PG_CHECKOUT_ENABLED=false
# 접근 제어는 운영 환경에서 항상 활성화됩니다. 비워두면 서버 자격 증명에서 안전하게 파생합니다.
BILLING_TRIAL_HASH_SECRET=
BILLING_RETRY_OFFSETS_HOURS=24,72
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_CHECKOUT_SESSION_MINUTES=20
CRON_SECRET=
